<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product - JS Commerce</title>
    <%- include('partials/head') %>
    <style>
        body {
            background-color: #f5f3f4;
        }
    </style>
</head>
<body>
    <nav class="flex items-center justify-between whitespace-nowrap border-b border-gray-200 px-10 py-4 bg-white sticky top-0 z-50">
  <div class="flex items-center gap-3 text-2xl font-bold text-gray-900">
    <div class="flex-shrink-0 flex items-center">
      <div class="w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center mr-3">
        <div class="w-4 h-4 bg-white rounded"></div>
      </div>
      <span class="text-xl font-bold text-gray-900">JS Commerce</span>
    </div>
  </div>

  <div class="flex flex-1 justify-center items-center gap-8">
    <a href="/" class="text-gray-600 hover:text-red-500 font-medium">Home</a>
    <a href="/products" class="text-gray-600 hover:text-red-500 font-medium">Products</a>
    <a href="/profile" class="text-gray-600 hover:text-red-500 font-medium">Profile</a>
  </div>

  <div class="flex flex-1 justify-end items-center gap-4">
    <div class="flex items-center bg-green-100 px-3 py-1 rounded-lg">
      <svg class="w-4 h-4 text-green-600 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
      </svg>
      <span class="text-green-700 font-semibold text-sm">
        $<%= balance %>
      </span>
    </div>

    <span class="text-gray-700 font-medium"><%= username %>!</span>

    <a href="/profile" class="flex items-center hover:opacity-80 transition-opacity">
      <div class="w-8 h-8 bg-orange-300 rounded-full flex items-center justify-center cursor-pointer hover:shadow-md transition-shadow">
        <div class="w-4 h-6 bg-amber-900 rounded-full"></div>
      </div>
    </a>
  </div>
</nav>


    <div class="min-h-screen w-full flex items-center justify-center p-20">
        <div class="bg-white rounded-2xl shadow-lg p-8 w-full max-w-2xl">
            <div class="text-center mb-8">
                <div class="flex justify-center mb-4">
                    <div class="w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center mr-3">
                        <div class="w-4 h-4 bg-white rounded"></div>
                    </div>
                    <span class="text-xl font-bold text-gray-900">JS Commerce</span>
                </div>
                <h1 class="text-2xl font-semibold text-gray-900 mb-2">Add Product</h1>
            </div>

            <form action="/products/add" method="post" class="space-y-6">
                <% if (errors !== undefined && errors.length) { %>
                    <div class="space-y-2">
                        <% errors.forEach(error => { %>
                            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl text-center">
                                <%= error %>
                            </div>
                        <% }) %>
                    </div>
                <% } %>

                <div>
                    <input 
                        type="text" 
                        name="name" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                        placeholder="Name Product"
                    >
                </div>

                <div>
                    <input 
                        type="number" 
                        name="price" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                        placeholder="Price Product"
                    >
                </div>

                <div>
                    <input 
                        type="number" 
                        name="stock" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                        placeholder="Stock Product"
                    >
                </div>

                <div>
                    <input 
                        type="text" 
                        name="description" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                        placeholder="Description Product"
                    >
                </div>

                <div>
                    <input 
                        type="text" 
                        name="imageUrl" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                        placeholder="Image Product"
                    >
                </div>

                <div>
                    <select 
                        name="CategoryId" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 text-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                    >
                        <option value="" disabled selected>Select Category</option>
                        <% categories.forEach(category => { %>
                            <option value="<%= category.id %>"><%= category.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="pt-4">
                    <input 
                        type="submit"
                        value="Create Product" 
                        class="w-full py-3 px-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-xl transition duration-300 cursor-pointer"
                    >
                </div>
            </form>
        </div>
    </div>
</body>
</html>