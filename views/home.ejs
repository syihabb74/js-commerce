<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JS Commerce - Homepage</title>
    <%- include('partials/head') %>
    <style>
        body {
            background-color: #f5f3f4;
        }
    </style>
</head>
<body>
    <header class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center mr-3">
                        <div class="w-4 h-4 bg-white rounded"></div>
                    </div>
                    <span class="text-xl font-bold text-gray-900">JS Commerce</span>
                </div>
                
                <nav class="hidden md:flex space-x-8">
                    <% if (uId) { %>
                        <a href="/products" class="text-gray-600 hover:text-red-500 transition-colors">Products</a>
                    <% } %>
                </nav>
                
                <div class="flex items-center space-x-4">
                    <% if (username) { %>
                        <div class="flex items-center space-x-3">
                            <div class="flex items-center bg-green-100 px-3 py-1 rounded-lg">
                                <svg class="w-4 h-4 text-green-600 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                </svg>
                                <span class="text-green-700 font-semibold text-sm">
                                    $<%= typeof balance !== 'undefined' ? balance : '0' %>
                                </span>
                            </div>
                            
                            <span class="text-gray-700 font-medium"><%= username %>!</span>
                            
                            <a href="/profile" class="flex items-center hover:opacity-80 transition-opacity">
                                <div class="w-8 h-8 bg-orange-300 rounded-full flex items-center justify-center cursor-pointer hover:shadow-md transition-shadow">
                                    <div class="w-4 h-6 bg-amber-900 rounded-full"></div>
                                </div>
                            </a>
                        </div>
                    <% } else { %>
                        <div class="flex items-center space-x-3">
                            <a href="/login" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-medium transition duration-200">
                                Login
                            </a>
                            <a href="/register" class="text-red-500 hover:text-red-600 font-medium transition-colors">
                                Sign Up
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </header>

        <div class="absolute bottom-0 right-0 w-64 h-64 opacity-30">
            <svg viewBox="0 0 200 200" class="w-full h-full">
                <path d="M100 200 Q 80 160 60 120 Q 80 100 100 80 Q 120 100 140 120 Q 120 160 100 200" fill="currentColor" class="text-green-800"/>
                <circle cx="100" cy="80" r="8" fill="currentColor" class="text-green-900"/>
                <path d="M100 80 Q 85 60 70 40 Q 85 35 100 30 Q 115 35 130 40 Q 115 60 100 80" fill="currentColor" class="text-green-700"/>
            </svg>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-12 text-center">Categories</h2>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                <% categories.forEach((el) => { %>
                    <a href="/products?CategoryId=<%= el.id %>" class="group">
                        <div class="bg-gradient-to-br from-orange-100 to-orange-200 rounded-2xl p-8 text-center hover:shadow-lg transition-all duration-300 group-hover:scale-105">
                            <div class="w-24 h-24 mx-auto mb-4 bg-white rounded-2xl flex items-center justify-center shadow-md">
                                <img src="https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=80&h=80&fit=crop" alt="<%= el.name %>" class="w-16 h-16 object-cover rounded-xl">
                            </div>
                            <h3 class="font-semibold text-gray-900"><%= el.name %></h3>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="col-span-full text-center py-12">
                    <p class="text-gray-500">No categories available at the moment.</p>
                </div>
            <% } %>
        </div>
    </section>

    <footer class="bg-white border-t border-gray-200 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <div class="flex items-center mb-4">
                        <div class="w-6 h-6 bg-red-500 rounded flex items-center justify-center mr-2">
                            <div class="w-3 h-3 bg-white rounded"></div>
                        </div>
                        <span class="font-bold text-gray-900">JS Commerce</span>
                    </div>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Trusted online shopping platform with a variety of quality products and affordable prices.
                    </p>
                </div>

                <div>
                    <h3 class="font-semibold text-gray-900 mb-4">Shopping</h3>
                    <ul class="space-y-2">
                        <li><a href="/products" class="text-gray-600 hover:text-red-500 transition-colors text-sm">New Products</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-red-500 transition-colors text-sm">Special Offer</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-red-500 transition-colors text-sm">Category</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="font-semibold text-gray-900 mb-4">About Us</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="text-gray-600 hover:text-red-500 transition-colors text-sm">Our Story</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-red-500 transition-colors text-sm">Career</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-red-500 transition-colors text-sm">Contact Us</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="font-semibold text-gray-900 mb-4">Help</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="text-gray-600 hover:text-red-500 transition-colors text-sm">FAQ</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-red-500 transition-colors text-sm">Guide</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-red-500 transition-colors text-sm">Track Order</a></li>
                    </ul>
                </div>
            </div>

            <div class="border-t border-gray-200 mt-8 pt-8">
                <div class="flex justify-between items-center">
                    <p class="text-gray-500 text-sm">© 2024 JS Commerce. All Right Reserved.</p>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-gray-600 transition-colors">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                            </svg>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-gray-600 transition-colors">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.566-1.35 2.14-2.21z"/>
                            </svg>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-gray-600 transition-colors">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.219-.359-1.219c0-1.142.662-1.995 1.482-1.995.699 0 1.037.525 1.037 1.155 0 .703-.449 1.754-.679 2.727-.194.820.412 1.492 1.219 1.492 1.464 0 2.588-1.543 2.588-3.77 0-1.97-1.417-3.348-3.445-3.348-2.346 0-3.723 1.76-3.723 3.582 0 .71.274 1.471.617 1.883.068.083.078.155.058.240-.063.264-.203.83-.231.946-.037.155-.121.188-.279.113-1.017-.474-1.653-1.971-1.653-3.165 0-2.605 1.893-4.993 5.461-4.993 2.871 0 5.102 2.042 5.102 4.774 0 2.849-1.797 5.140-4.289 5.140-.837 0-1.626-.435-1.895-.955l-.516 1.955c-.188.724-.695 1.634-1.037 2.188 1.179.365 2.421.562 3.706.562 6.624 0 11.99-5.367 11.99-11.987C24.007 5.367 18.641.001 12.017.001z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</body>
