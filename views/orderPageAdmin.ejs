<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/navAdmin') %>
    <title>Order Page (Admin)</title>
    <%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-50 font-sans">
    <div class="flex min-h-screen">
        <div class="w-64 bg-white shadow-lg">
            <div class="p-6 border-b">
                <h1 class="text-xl font-bold text-gray-800">JS Commerce</h1>
            </div>
            
            <nav class="mt-6">
                <ul class="space-y-2">
                    <li>
                        <a href="/admin" class="flex items-center px-6 py-3 mr-4 <%= isChoose(activeSide, 'home') %>">
                            <span class="w-2 h-2 bg-white rounded-full mr-3"></span>
                            Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/admin/order" class="flex items-center px-6 py-3 <%= isChoose(activeSide, 'order') %>">
                            <span class="w-2 h-2 bg-gray-400 rounded-full mr-3"></span>
                            Order
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <div class="flex-1 flex flex-col">
            <div class="bg-white shadow-sm border-b px-6 py-4 flex justify-between items-center">
                <h2 class="text-2xl font-semibold text-gray-800">Order List</h2>
            </div>

            <div class="flex-1 p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div class="bg-white rounded-lg p-6 shadow-sm">
                        <h3 class="text-sm font-medium text-gray-600 mb-2">Total Price</h3>
                        <div class="text-3xl font-bold text-gray-900">$<%= totalPrice %></div>
                    </div>

                    <div class="bg-white rounded-lg p-6 shadow-sm">
                        <h3 class="text-sm font-medium text-gray-600 mb-2">Total Quantity</h3>
                        <div class="text-3xl font-bold text-gray-900"><%= totalQuantity %></div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">Order List</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Product
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Quantity
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Price
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% salesReport.forEach(el => { %>
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                            <%= el.Product.name %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            <%= el.quantity %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            <%= el.price %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>