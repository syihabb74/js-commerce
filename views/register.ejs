<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - ShopAll</title>
    <%- include('partials/head') %>
    <style>
        body {
            background-color: #f5f3f4;
        }
    </style>
</head>
<body>
    <div class="min-h-screen w-full flex items-center justify-center p-20">
        <div class="bg-white rounded-2xl shadow-lg p-8 w-full max-w-md">
            <div class="text-center mb-8">
                <div class="flex justify-center mb-4">
                    <div class="w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center mr-3">
                        <div class="w-4 h-4 bg-white rounded"></div>
                    </div>
                    <span class="text-xl font-bold text-gray-900">ShopAll</span>
                </div>
                <h1 class="text-2xl font-semibold text-gray-900 mb-2">Create Your Account</h1>
            </div>

            <form action="/register" method="post" class="space-y-6">
                <% if (errorpasswordmatch) { %>
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl text-center">
                        <%= errorpasswordmatch %>
                    </div>
                <% } %>
                
                <% if (erroremail) { %>
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl text-center">
                        <%= erroremail %>
                    </div>
                <% } %>
                
                <% if (invalidcode) { %>
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl text-center">
                        <%= invalidcode %>
                    </div>
                <% } %>

                <div>
                    <input 
                        type="text" 
                        name="username" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                        placeholder="Username"
                    >
                </div>

                <div>
                    <input 
                        type="email" 
                        name="email" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                        placeholder="Email"
                    >
                </div>

                <div>
                    <input 
                        type="password" 
                        name="password" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                        placeholder="Password"
                    >
                </div>

                <div>
                    <input 
                        type="password" 
                        name="confirmationPass" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200"
                        placeholder="Confirmation Password"
                    >
                </div>

                <div>
                    <input 
                        type="submit"
                        value="Register" 
                        class="w-full py-3 px-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-xl transition duration-300 cursor-pointer"
                    >
                </div>
            </form>
            <div class="mt-6 text-center">
                <a href="/login" class="text-red-500 hover:text-red-600 font-medium transition-colors">
                    Already have an account? Sign in
                </a>
            </div>
        </div>
    </div>
</body>
</html>