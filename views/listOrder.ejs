<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Riwayat Pesanan - JS Commerce</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
</style>
</head>
<body class="bg-gray-50 text-gray-900">
<div class="relative flex size-full min-h-screen flex-col group/design-root overflow-x-hidden">
<div class="layout-container flex h-full grow flex-col">
<header class="flex items-center justify-between whitespace-nowrap border-b border-gray-200 px-10 py-4">
<div class="flex items-center gap-3 text-2xl font-bold text-gray-900">
<div class="flex-shrink-0 flex items-center">
                        <div class="w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center mr-3">
                            <div class="w-4 h-4 bg-white rounded"></div>
                        </div>
                        <span class="text-xl font-bold text-gray-900">ShopEase</span>
                    </div>
</div>
<div class="flex flex-1 justify-center items-center gap-8">
<a href="/" class="text-gray-600 hover:text-blue-600 font-medium">Home</a>
<a href="/products" class="text-gray-600 hover:text-blue-600 font-medium">Products</a>
<a href="/profile" class="text-gray-600 hover:text-blue-600 font-medium">Profile</a>
</div>
<div class="flex flex-1 justify-end items-center gap-4">
<div class="flex items-center space-x-4">
                    <button class="relative p-2 text-gray-400 hover:text-gray-500">
                    </button>
                    <div class="flex items-center space-x-3">
                            <div class="flex items-center bg-green-100 px-3 py-1 rounded-lg">
                                <svg class="w-4 h-4 text-green-600 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                </svg>
                                <span class="text-green-700 font-semibold text-sm">
                                    $<%= balance %>
                                </span>
                            </div>
                            
                            <span class="text-gray-700 font-medium"><%= username %>!</span>
                            
                            <a href="/profile" class="flex items-center hover:opacity-80 transition-opacity">
                                <div class="w-8 h-8 bg-orange-300 rounded-full flex items-center justify-center cursor-pointer hover:shadow-md transition-shadow">
                                    <div class="w-4 h-6 bg-amber-900 rounded-full"></div>
                                </div>
                            </a>
                        </div>
                        
                </div>
</div>
</header>
<main class="flex-1 container mx-auto px-4 sm:px-6 lg:px-8 py-8">
<div class="max-w-4xl mx-auto">
<h1 class="text-3xl font-extrabold tracking-tight text-gray-900 mb-8">Riwayat Pesanan</h1>
<div class="bg-white shadow-md rounded-lg overflow-hidden">
<div class="overflow-x-auto">
<table class="w-full min-w-full divide-y divide-gray-200">
<thead class="bg-gray-50">
<tr>
<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" scope="col">Order No</th>
<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" scope="col">Date</th>
<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" scope="col">Total</th>
<th class="relative px-6 py-3" scope="col"><span class="sr-only">Detail</span></th>
</tr>
</thead>
<tbody class="bg-white divide-y divide-gray-200">
    <% orders.forEach(el => { %>
        <tr class="hover:bg-gray-50 transition-colors cursor-pointer">
        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">#<%= el.id %></td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= el.formatDateOrder %></td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= el.totalAmount %></td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <a class="text-red-600 hover:text-red-700" href="/profile/orders/<%= el.id %>">Lihat Detail</a>
        </td>
        </tr>
    <% }) %>
</tbody>
</table>
</div>
</div>
</div>
</main>
</div>
</div>

</body>
</html>