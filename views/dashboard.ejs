<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/nav') %>
    <title>Verification</title>
    <%- include('partials/head') %>
</head>
<body>
    <div class="min-h-screen w-full flex justify-center p-20" style="background-color: #EEE7E8">
        <% if (deleted) { %>
            <h2 class="text-red-500 text-center"><%= deleted %> Has been Successfully Deleted</h2>
        <% } %>
        <div class="grid grid-cols-5 bg-white gap-3 rounded-2xl p-4" style="background-color: #F9FAFB;">
            <% listProduct.forEach(el => { %>
                <div class="bg-white rounded-xl overflow-hidden hover:shadow-2xl shadow-lg transition duration-500 ease-in-out">
                    <div class="overflow-hidden">
                        <img class="w-full h-48 object-cover" src="<%= el.imageUrl %>" alt="<%= el.name %>">
                    </div>
                    <div class="p-3">
                        <h3 class="font-semibold text-lg mb-2"><%= el.name %></h3>
                        <div>
                            <p class="text-gray-600 text-sm mb-2"><%= el.maxFourWords %><a style="color: black;" href="/products/<%= el.id %>"> Get Details...</a></p>
                        </div>
                        <h2 class="text-red-500 font-bold text-xl">$<%= el.price %></h2>
                        <% if (el.price) { %>
                            <h2 class="mb-2 mt-2 text-red-400 font-bold text-sm">Stock : <%= el.stock %></h2>
                        <% } else { %>
                            <h2 class="mb-2 mt-2 text-red-400 font-bold text-sm">Out Of Stock</h2>
                        <% } %>
                        <div class="grid grid-rows-3 gap-3">
                                <% if (id !== el.UserId) { %>
                                    <div>
                                    <a href="buy/1/<%= el.id %>">
                                        <button class="bg-blue-500 hover:bg-blue-600 text-white px-2 text-xs py-1 rounded-md transition duration-300 font-semibold">Buy Now</button>
                                    </a>
                                    </div>
                                <% } %>
                                <% if (el.UserId === id) { %>
                                    <div>
                                        <a href="products/edit/<%= el.id %>">
                                            <button class="bg-gray-500 hover:bg-gray-600 text-white px-2 text-xs py-1 rounded-md transition duration-300 font-semibold">Edit Product</button>
                                        </a>
                                    </div>
                                <% } %>
                            <% if (el.UserId === id) { %>
                                <div>
                                    <a href="/products/delete/<%= el.id %>">
                                        <button class="bg-red-500 hover:bg-red-600 text-white px-2 text-xs py-1 rounded-md transition duration-300 font-semibold">Delete Product</button>
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>



    <%- include('partials/bodyBS') %>
</body>
</html>