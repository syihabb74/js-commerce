<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/navAdmin') %>
    <title>Verification</title>
    <%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-50 font-sans">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-lg">
            <!-- Logo/Brand -->
            <div class="p-6 border-b">
                <h1 class="text-xl font-bold text-gray-800">TokoKu</h1>
            </div>
            
            <!-- Navigation Menu -->
            <nav class="mt-6">
                <ul class="space-y-2">
                    <li>
                        <a href="/admin" class="flex items-center px-6 py-3 text-white bg-red-500 rounded-r-full mr-4">
                            <span class="w-2 h-2 bg-white rounded-full mr-3"></span>
                            Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center px-6 py-3 text-gray-600 hover:text-gray-800 hover:bg-gray-100">
                            <span class="w-2 h-2 bg-gray-400 rounded-full mr-3"></span>
                            Produk
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center px-6 py-3 text-gray-600 hover:text-gray-800 hover:bg-gray-100">
                            <span class="w-2 h-2 bg-gray-400 rounded-full mr-3"></span>
                            Pesanan
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center px-6 py-3 text-gray-600 hover:text-gray-800 hover:bg-gray-100">
                            <span class="w-2 h-2 bg-gray-400 rounded-full mr-3"></span>
                            Pelanggan
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center px-6 py-3 text-gray-600 hover:text-gray-800 hover:bg-gray-100">
                            <span class="w-2 h-2 bg-gray-400 rounded-full mr-3"></span>
                            Pengaturan
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col">
            <!-- Top Bar -->
            <div class="bg-white shadow-sm border-b px-6 py-4 flex justify-between items-center">
                <h2 class="text-2xl font-semibold text-gray-800">Dashboard</h2>
            </div>

            <!-- Dashboard Content -->
            <div class="flex-1 p-6">
                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                    <!-- Penjualan Terbaru -->
                    <div class="bg-white rounded-lg p-6 shadow-sm">
                        <h3 class="text-sm font-medium text-gray-600 mb-2">Total Sales</h3>
                        <div class="text-3xl font-bold text-gray-900">$12,500</div>
                        <div class="text-sm text-green-500 mt-1">↗ +15%</div>
                    </div>

                    <!-- Pelanggan Aktif -->
                    <div class="bg-white rounded-lg p-6 shadow-sm">
                        <h3 class="text-sm font-medium text-gray-600 mb-2">Active Users</h3>
                        <div class="text-3xl font-bold text-gray-900"><%= listUsers.length %></div>
                    </div>

                    <!-- Pesanan Baru -->
                    <div class="bg-white rounded-lg p-6 shadow-sm">
                        <h3 class="text-sm font-medium text-gray-600 mb-2">Total Order</h3>
                        <div class="text-3xl font-bold text-gray-900">100</div>
                    </div>
                </div>

                <!-- Chart Section -->
                <div class="bg-white rounded-lg p-6 shadow-sm mb-6">
                    <canvas id="salesChart" width="400" height="150"></canvas>
                </div>

                <!-- Products Table -->
                <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg font-medium text-gray-900">List Product Sales</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Product
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Price
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Stock
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% listProducts.forEach(el => { %>
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                            <%= el.name %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            <%= el.price %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            <%= el.stock %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Chart Script -->
    <script>
        // Sales Chart
        const productPrices = JSON.parse('<%- productsPrice %>')
        const name = productPrices.map(el => el.productName)
        const price = productPrices.map(el => el.productPrice)
        console.log(name)
        console.log(price)
        const ctx = document.getElementById('salesChart').getContext('2d');
        const salesChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: name,
                datasets: [{
                    label: 'Sales',
                    data: price,
                    borderColor: 'rgb(239, 68, 68)',
                    backgroundColor: 'rgba(239, 68, 68, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            display: false
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>