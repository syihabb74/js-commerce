<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopEase - Profil User</title>
    <%- include('partials/head') %>
    <style>
        body {
            background-color: #f5f3f4;
        }
    </style>
</head>
<body>
    <header class="bg-white shadow-sm sticky top-0 z-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center">
                        <div class="w-8 h-8 bg-red-500 rounded-lg flex items-center justify-center mr-3">
                            <div class="w-4 h-4 bg-white rounded"></div>
                        </div>
                        <span class="text-xl font-bold text-gray-900">ShopAll</span>
                    </div>
                </div>
                
                <nav class="hidden md:flex space-x-6">
                    <a href="/products" class="text-gray-600 hover:text-red-500">Products</a>
                </nav>
                
                <div class="flex items-center space-x-4">
                    <button class="relative p-2 text-gray-400 hover:text-gray-500">
                    </button>
                    <div class="flex items-center space-x-3">
                            <div class="flex items-center bg-green-100 px-3 py-1 rounded-lg">
                                <svg class="w-4 h-4 text-green-600 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                </svg>
                                <span class="text-green-700 font-semibold text-sm">
                                    $<%= balance %>
                                </span>
                            </div>
                            
                            <span class="text-gray-700 font-medium"><%= username %>!</span>
                            <a href="/profile" class="flex items-center hover:opacity-80 transition-opacity">
                                <div class="w-8 h-8 bg-orange-300 rounded-full flex items-center justify-center cursor-pointer hover:shadow-md transition-shadow">
                                    <div class="w-4 h-6 bg-amber-900 rounded-full"></div>
                                </div>
                            </a>
                        </div>
                        
                </div>
            </div>
        </div>
    </header>

    <div class="flex justify-center min-h-screen w-full p-10">
        <div class="bg-white w-full rounded-2xl p-5 grid grid-cols-4 gap-5">
            <div class="bg-white col-span-1 rounded-2xl p-5">
                <div class="max-w-sm mx-auto bg-white rounded-3xl p-8 shadow-lg">
                    <div class="space-y-6">
                        <div>
                            <div class="text-center">
                                <div class="relative inline-block">
                                    <div class="w-28 h-28 bg-gradient-to-br from-orange-200 to-orange-300 rounded-full mx-auto mb-5 relative overflow-hidden">
                                        <div class="absolute top-6 left-1/2 transform -translate-x-1/2 w-8 h-10 bg-amber-900 rounded-full"></div>
                                        <div class="absolute bottom-7 left-1/2 transform -translate-x-1/2 w-12 h-6 bg-white rounded-t-full"></div>
                                    </div>
                                    <div class="absolute bottom-1 right-1 w-6 h-6 bg-red-500 rounded-full border-2 border-white flex items-center justify-center">
                                        <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                </div>
                                <h1 class="text-2xl font-semibold text-gray-900 mb-2"><%= dataValues.username %></h1>
                                <p class="text-gray-500"><%= dataValues.email %></p>
                            </div>
                        </div>
                        
                        <div class="space-y-2">
                            <a href="#informasi-pribadi" class="flex items-center p-4 bg-red-500 text-white rounded-xl hover:bg-red-600 transition-colors">
                                <svg class="w-5 h-5 mr-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                                </svg>
                                <span class="font-medium">Informasi Pribadi</span>
                            </a>
                            
                            <a href="/profile/orders" class="flex items-center p-4 text-gray-700 rounded-xl hover:bg-gray-50 transition-colors">
                                <svg class="w-5 h-5 mr-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
                                    <path fill-rule="evenodd" d="M4 5a2 2 0 012-2v1a1 1 0 102 0V3h4v1a1 1 0 102 0V3a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"></path>
                                </svg>
                                <span class="font-medium text-gray-600">Riwayat Pesanan</span>
                            </a>
                            
                            <a href="/products/add" class="flex items-center p-4 text-gray-700 rounded-xl hover:bg-gray-50 transition-colors">
                                <svg class="w-5 h-5 mr-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"></path>
                                </svg>
                                <span class="font-medium text-gray-600">Create Product</span>
                            </a>
                            
                            <a href="#" class="flex items-center p-4 text-red-500 rounded-xl hover:bg-red-50 transition-colors">
                                <svg class="w-5 h-5 mr-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"></path>
                                </svg>
                                <span class="font-medium">Logout</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white col-span-3 shadow-lg rounded-2xl p-8">
                <div id="informasi-pribadi" class="mb-10">
                    <h2 class="text-3xl font-bold text-gray-900 mb-8">Informasi Pribadi</h2>    
                    <form method="POST" action="/profile" class="space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="firstName" class="block text-base font-medium text-gray-700 mb-3">
                                    First Name
                                </label>
                                <input 
                                    type="text" 
                                    name="firstName" 
                                    value="<%= profile.firstName %>"
                                    class="w-full px-4 py-4 text-base text-gray-900 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 bg-white"
                                    placeholder="First Name"
                                >
                            </div>
                            
                            <div>
                                <label for="lastName" class="block text-base font-medium text-gray-700 mb-3">
                                    Last Name
                                </label>
                                <input 
                                    type="text" 
                                    name="lastName" 
                                    value="<%= profile.lastName %>"
                                    class="w-full px-4 py-4 text-base text-gray-900 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 bg-white"
                                    placeholder="Masukkan nama belakang"
                                >
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="dateOfBirth" class="block text-base font-medium text-gray-700 mb-3">
                                    Date of Birth
                                </label>
                                <input 
                                    type="date" 
                                    name="dateOfBirth" 
                                    value="<%= profile.dateOfBirth ? profile.formatDate : '' %>"
                                    class="w-full px-4 py-4 text-base text-gray-900 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 bg-white"
                                >
                            </div>
                            
                            <div>
                                <label for="gender" class="block text-base font-medium text-gray-700 mb-3">
                                    Gender
                                </label>
                                <select 
                                    name="gender" 
                                    id="gender"
                                    class="w-full px-4 py-4 text-base text-gray-900 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 bg-white"
                                >
                                    <% if (!profile.gender) { %>
                                        <option selected disabled>Choose Your Gender</option>
                                    <% } %>
                                    <option value="Male" <%= profile.gender === 'Male' ? 'selected' : '' %>>Male</option>
                                    <option value="Female" <%= profile.gender === 'Female' ? 'selected' : '' %>>Female</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label for="address" class="block text-base font-medium text-gray-700 mb-3">
                                Address
                            </label>
                            <textarea 
                                id="address" 
                                name="address" 
                                rows="4"
                                class="w-full px-4 py-4 text-base text-gray-900 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 bg-white resize-none"
                                placeholder="Masukkan alamat lengkap"
                            ><%= profile.address %></textarea>
                        </div>
                        <% if (erroraddress) { %>
                         <h3 class="text-xl" style="color: red;"><%= erroraddress %></h3>
                        <% } %>

                        <div class="flex justify-end pt-4">
                            <button 
                                type="submit"
                                class="inline-flex items-center px-8 py-4 bg-red-500 hover:bg-red-600 text-white font-semibold text-base rounded-full transition-all duration-200 shadow-lg hover:shadow-xl focus:ring-4 focus:ring-red-500 focus:ring-opacity-50"
                            >
                                <i class="fas fa-save mr-3"></i>
                                Save
                            </button>
                        </div>
                    </form>
                </div>

                <div id="top-up" class="mb-10 border-t border-gray-200 pt-10">
                    <h2 class="text-3xl font-bold text-gray-900 mb-8">Top Up Balance</h2>
                    <% if (errorbalance) { %>
                     <h3 class="text-2xl font-bold text-red-500 mb-8"><%= errorbalance %></h3>
                    <% } %>
                    <form method="POST" action="/profile/topup" class="bg-gray-50 mb-5 rounded-2xl p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="amount" class="block text-base font-medium text-gray-700 mb-3">
                                    Amount ($)
                                </label>
                                <input 
                                    type="number" 
                                    name="balance" 
                                    id="amount"
                                    class="w-full px-4 py-4 text-base text-gray-900 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all duration-200 bg-white"
                                    placeholder="Enter amount"
                                >
                                
                            </div>
                            <div class="flex items-end">
                                <button 
                                    type="submit"
                                    class="w-full inline-flex items-center justify-center px-6 py-4 bg-green-500 hover:bg-green-600 text-white font-semibold text-base rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl focus:ring-4 focus:ring-green-500 focus:ring-opacity-50"
                                >
                                    <i class="fas fa-plus mr-2"></i>
                                    Top Up Now
                                </button>
                            </div>
                        </div>
                    </form>
                    <% if (errortopup) { %>
                                 <h3 class="text-xl" style="color: red;"><%= errortopup %></h3>
                    <% } %>
                </div>

                <div id="riwayat-pesanan" class="border-t border-gray-200 pt-10">
                    <div class="flex justify-between items-center mb-8">
                        <h2 class="text-3xl font-bold text-gray-900">History</h2>
                        <a href="/profile/orders"><button class="text-red-500 font-medium hover:text-red-600 transition-colors">See All</button></a>
                    </div>

                    <% orders.forEach(el => { %>
                        <a href="/profile/orders/<%= el.OrderItems[0].id %>"><div class="space-y-4 mb-5">
                            <div class="flex items-center justify-between p-6 border border-gray-200 rounded-2xl hover:shadow-md transition-shadow">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center">
                                        <svg class="w-6 h-6 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 100-2H6z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="text-lg font-semibold text-gray-900">Order #<%= el.id %></h3>
                                        <p class="text-gray-500 text-sm"><%= el.formatDateOrder %></p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                </div>
                            </div>
                        </div></a>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>

</body>
</html>