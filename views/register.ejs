<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verification</title>
    <%- include('partials/head') %>
</head>
<body>
    <div class="min-h-screen w-full flex justify-center p-20" style="background-color: #EEE7E8">
        <div class=" flex items-center justify-center bg-white rounded-2xl p-4 w-full">
            <form action="/register" method="post">
                <h1 style="text-align: center;" class="mb-10 text-2xl">Create Your Account</h1>
                <div class="max-w-4xl grid grid-rows-6 gap-5">
                        <input style="background-color: #F9FAFB ;display: inline-block;" class="w-lg h-10 shadow-sm px-3" name="username" type="text" placeholder="Username" id="">
                        <input style="background-color: #F9FAFB ;display: inline-block;" class="w-lg h-10 shadow-sm px-3" name="email" type="email" placeholder="Email" id="">
                        <input style="background-color: #F9FAFB ;display: inline-block;" class="w-lg h-10 shadow-sm px-3" name="password" type="password" placeholder="Password" id="">
                        <input style="background-color: #F9FAFB ;display: inline-block;" class="w-lg h-10 shadow-sm px-3" name="confirmationPass" type="password" placeholder="Confirmation Password" id="">
                        <input style="display: inline-block; font-size: 16px;" class="text-center w-lg h-10 shadow-sm bg-red-500 hover:bg-red-600 text-white px-2 text-xs py-1 rounded-md transition duration-300 font-semibold" value="Register" type="submit">
                </div>
            </form>
        </div>
    </div>
</body>
</html>






